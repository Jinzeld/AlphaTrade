# ── Alpaca ─────────────────────────────────────────────────────────────────
ALPACA_KEY=your_alpaca_key_here
ALPACA_SECRET=your_alpaca_secret_here
IS_PAPER=True

# NVIDIA NIM ───────────────────────────────────────────────────────────────
NVIDIA_NIM_KEY=nvapi-your_key_here
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct

# ── Finnhub (free news API) ────────────────────────────────────────────────
# Get free key at finnhub.io
FINNHUB_KEY=your_finnhub_key_here

# ── Discord ────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_WEBHOOK=https://discord.com/api/webhooks/your_webhook_here

# Channel for trade signals (existing)
DISCORD_CHANNEL_ID=your_signals_channel_id_here

# Channel for daily news (new — create a #daily-news channel in Discord)
DISCORD_NEWS_CHANNEL_ID=your_news_channel_id_here

#Stocks channel
DISCORD_LONGTERMCHANNEL_ID=your_channel_id_here

# new — your 3 option trade channels
DISCORD_0DTE_CHANNEL_ID=paste_0dte_trades_channel_id
DISCORD_SWING_CHANNEL_ID=paste_swing_trades_channel_id
DISCORD_SETTINGS_CHANNEL_ID=paste_option_trades_settings_channel_id
